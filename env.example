# ---------------------------------------------------------------------------
# WebinarFlow-AI environment configuration
# Copy to `.env` (backend) and `frontend/.env.local` (frontend) and fill in.
# Every variable here has a safe default in backend/app/core/config.py, so the
# app boots with only the database + AI keys set.
# ---------------------------------------------------------------------------

# === App ===
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# === Database (async) ===
# Postgres in production; set SQLITE_FALLBACK=true for local tinker w/o Postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/webinarflow
SQLITE_FALLBACK=false

# === CORS (comma-separated list of allowed origins) ===
BACKEND_CORS_ORIGINS=http://localhost:3000

# === Auth / JWT ===
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# === Email (SMTP) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WebinarFlow-AI

# === Google OAuth ===
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# === AI providers ===
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# === Zoom (server-to-server OAuth) ===
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# === Google Meet (service account JSON, single-line or path) ===
GOOGLE_MEET_CREDENTIALS_JSON=

# === WhatsApp (Meta Cloud API) ===
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# === Payments ===
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# === Redis / Celery ===
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# === Frontend ===
FRONTEND_URL=http://localhost:3000
# Frontend uses NEXT_PUBLIC_API_URL to point at the backend (or the /api rewrite)
NEXT_PUBLIC_API_URL=http://localhost:8000
